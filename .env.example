# =============================================================================
# Copy this file to ".env" and fill in the values. NEVER commit ".env".
# Everything here is SERVER-SIDE ONLY. Nothing in this file is ever sent to the
# browser.
# =============================================================================

# --- Web server ---------------------------------------------------------------
PORT=5000
# The public address of your site, without a trailing slash. Used in email links.
#   Local:      http://localhost:5000
#   Production: https://your-project.vercel.app
BASE_URL=http://localhost:5000

# --- Database (Supabase) --------------------------------------------------------
# Supabase -> your project -> "Connect" button (top of the page) -> "Transaction pooler"
# -> copy the URI and replace [YOUR-PASSWORD] with your database password.
# Looks like: postgresql://postgres.abcd1234:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres
# SECRET: this gives full database access. Server only.
DATABASE_URL=

# --- Email (Resend) -------------------------------------------------------------
# Leave EMAIL_PROVIDER=none until you set up Resend. With "none", signups still
# work: people get their access link on screen instead of by email.
EMAIL_PROVIDER=none
# Resend -> API Keys -> Create API Key. SECRET. Server only.
EMAIL_API_KEY=
# Must use a domain you verified in Resend, e.g.  Roblox Analytics <hello@yourdomain.com>
# (Resend's test sender onboarding@resend.dev only delivers to your own address.)
EMAIL_FROM=

# --- Roblox data collection (defaults are fine) ---------------------------------
ROBLOX_REQUEST_DELAY_MS=250
ROBLOX_MAX_RETRIES=3
ROBLOX_MAX_GAMES=300
# Charts to collect from (comma-separated).
ROBLOX_SORT_IDS=top-playing-now,top-trending,up-and-coming,top-revisited
# Optional: extra Roblox universe IDs to always track (comma-separated).
ROBLOX_EXTRA_UNIVERSE_IDS=

# --- Trends (defaults are fine) -------------------------------------------------
# A game is "Growing" if its visits/day rose by at least this % week over week.
TREND_THRESHOLD_PCT=10
# Games not refreshed for this many days are hidden as stale.
STALE_AFTER_DAYS=3

# --- Optional -------------------------------------------------------------------
# Other website addresses allowed to call the API from a browser (comma-separated).
CORS_ORIGINS=

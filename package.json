{
  "name": "roblox-analytics",
  "version": "1.1.0",
  "private": true,
  "description": "Roblox game analytics platform: real Roblox chart data, daily snapshots, trends, and a beta signup flow",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "scrape": "node scripts/scrape.js",
    "db:migrate": "node scripts/migrate.js",
    "check-env": "node scripts/check-env.js",
    "test": "node --test --test-concurrency=1 \"test/*.test.js\""
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8"
  }
}
